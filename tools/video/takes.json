    "ready_js": "!!window.__app && (function(){const l=document.querySelector('#loading'); return !l || l.classList.contains('done');})()",
    "steps": [
      {"wait": 1},
      {"move": "#m-tbody tr:first-child"},
      {"highlight": ["#m-tbody tr:first-child", 1.5]},
      {"click": "button[data-view=compare]"},
      {"wait": 3}
    ]
  }
