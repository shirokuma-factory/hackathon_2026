{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kit/schema/point.json",
  "title": "地点の点（Kit.points のデータ）",
  "description": "地点ごとの量。大きさは value、色の区分は level（無ければ value）で決まる。",
  "type": "object",
  "required": [
    "points"
  ],
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "description": "ファイルの説明（任意）。架空のデータには fiction: true を付ける",
      "properties": {
        "title": {
          "type": "string"
        },
        "fiction": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "basis": {
      "type": "string",
      "enum": [
        "実測",
        "推定",
        "仮定"
      ],
      "description": "実測 = 記録から数えた値、推定 = 計算で求めた値、仮定 = 利用者が置いた値"
    },
    "point": {
      "type": "object",
      "required": [
        "id",
        "name",
        "lon",
        "lat",
        "value",
        "unit",
        "basis"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "description": "経度（度）"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "description": "緯度（度）"
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "description": "量（点の大きさ）"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "number",
          "description": "色の区分に使う数（点の中の数字）。無ければ value"
        },
        "band": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "区分を直接指定する（0〜3）。指定しなければ設定の bands と level で決まる"
        },
        "period": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/basis"
        }
      }
    }
  }
}
